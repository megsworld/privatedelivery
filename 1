<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Open Me</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #2f2334;
        --soft-ink: #705c77;
        --paper: #fffaf2;
        --rose: #ef5f7e;
        --coral: #ff9472;
        --blue: #8fc9ff;
        --green: #9ed7bd;
        --line: rgba(47, 35, 52, 0.13);
        --shadow: 0 28px 80px rgba(74, 42, 61, 0.24);
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        display: grid;
        place-items: center;
        overflow-x: hidden;
        padding: env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
        background:
          linear-gradient(rgba(255, 255, 255, 0.34) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.3) 1px, transparent 1px),
          radial-gradient(circle at 18% 12%, #ffd166 0 12%, transparent 24%),
          radial-gradient(circle at 88% 22%, #8fc9ff 0 13%, transparent 25%),
          radial-gradient(circle at 75% 88%, #9ed7bd 0 15%, transparent 28%),
          linear-gradient(145deg, #ffe4ec 0%, #fff2d8 50%, #eaf5ff 100%);
        background-size: 36px 36px, 36px 36px, auto, auto, auto, auto;
        color: var(--ink);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background:
          radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.6), transparent 28%),
          linear-gradient(180deg, transparent, rgba(255, 149, 114, 0.16));
        pointer-events: none;
      }

      .wrap {
        position: relative;
        z-index: 2;
        width: min(92vw, 390px);
        min-height: 640px;
        display: grid;
        align-items: center;
        padding: 22px 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px) scale(0.98);
        transition: opacity 520ms ease, transform 520ms ease, visibility 0ms linear 520ms;
      }

      .open .wrap {
        opacity: 1;
        visibility: visible;
        transform: translateY(0) scale(1);
        transition-delay: 180ms, 180ms, 0ms;
      }

      .letter {
        position: relative;
        width: 100%;
        padding: 30px 24px 24px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background:
          linear-gradient(90deg, rgba(239, 95, 126, 0.1) 1px, transparent 1px) 31px 0 / 32px
            100% no-repeat,
          repeating-linear-gradient(
            to bottom,
            transparent 0 34px,
            rgba(143, 201, 255, 0.34) 35px 36px
          ),
          var(--paper);
        box-shadow: var(--shadow);
        transform: rotate(-1.1deg);
        animation: slideIn 680ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .letter::before {
        content: "";
        position: absolute;
        left: 18px;
        right: 18px;
        top: 12px;
        height: 10px;
        border-radius: 999px;
        background:
          radial-gradient(circle, rgba(47, 35, 52, 0.2) 1px, transparent 2px) 0 0 / 16px
            10px;
        opacity: 0.5;
      }

      .tag {
        width: fit-content;
        margin: 4px auto 18px;
        padding: 7px 12px;
        border: 1px solid rgba(47, 35, 52, 0.14);
        border-radius: 999px;
        background: #fff;
        color: var(--soft-ink);
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.25rem, 17vw, 5.4rem);
        line-height: 0.82;
        letter-spacing: 0;
        text-align: center;
      }

      h1 span {
        display: block;
        color: var(--rose);
      }

      .copy {
        margin: 24px auto 0;
        max-width: 29ch;
        color: var(--soft-ink);
        font-size: 1rem;
        line-height: 1.6;
        text-align: center;
      }

      .meter {
        margin: 24px 0 18px;
        padding: 14px;
        border: 1px solid rgba(47, 35, 52, 0.1);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.62);
      }

      .meter-top {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 10px;
        color: var(--soft-ink);
        font-size: 0.8rem;
        font-weight: 800;
      }

      .bar {
        height: 13px;
        overflow: hidden;
        border-radius: 999px;
        background: #eadfe7;
      }

      .fill {
        width: 72%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--rose), var(--coral));
        transition: width 450ms ease;
      }

      .actions {
        display: grid;
        gap: 10px;
      }

      button,
      a.button {
        min-height: 52px;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 14px;
        color: #fff;
        background: var(--ink);
        font: inherit;
        font-size: 0.96rem;
        font-weight: 850;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 15px 26px rgba(47, 35, 52, 0.24);
        transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
      }

      button:hover,
      a.button:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 32px rgba(47, 35, 52, 0.28);
      }

      button:active,
      a.button:active {
        transform: translateY(0) scale(0.985);
      }

      .ghost {
        color: var(--ink);
        background: #ffffff;
      }

      .response {
        min-height: 50px;
        margin-top: 16px;
        color: #9d3154;
        font-size: 0.95rem;
        font-weight: 850;
        line-height: 1.45;
        text-align: center;
      }

      .floating {
        position: fixed;
        z-index: 3;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        user-select: none;
        transition: opacity 420ms ease, visibility 0ms linear 420ms;
      }

      .open .floating {
        opacity: 1;
        visibility: visible;
        transition-delay: 320ms, 0ms;
      }

      .kiss {
        left: clamp(14px, 8vw, 92px);
        top: clamp(40px, 12vh, 105px);
        z-index: 1;
        width: 64px;
        height: 64px;
        background: linear-gradient(145deg, #ef5f7e, #ff9472);
        transform: rotate(45deg);
        box-shadow: 0 20px 42px rgba(239, 95, 126, 0.25);
        animation: heartBob 5s ease-in-out infinite;
      }

      .kiss::before,
      .kiss::after {
        content: "";
        position: absolute;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: inherit;
      }

      .kiss::before {
        left: -32px;
        top: 0;
      }

      .kiss::after {
        left: 0;
        top: -32px;
      }

      .bubble {
        position: fixed;
        right: 12px;
        top: min(78svh, 610px);
        z-index: 5;
        max-width: 190px;
        padding: 10px 13px;
        border: 1px solid rgba(47, 35, 52, 0.12);
        border-radius: 18px 18px 5px 18px;
        background: rgba(255, 255, 255, 0.92);
        color: var(--ink);
        font-size: 0.78rem;
        font-weight: 850;
        line-height: 1.35;
        text-align: center;
        box-shadow: 0 10px 22px rgba(74, 42, 61, 0.1);
        animation: bubbleBob 5s ease-in-out -2s infinite;
      }

      .spark {
        position: fixed;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        pointer-events: none;
        animation: pop 850ms ease-out forwards;
      }

      .opener {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: grid;
        place-items: center;
        padding: 24px;
        border: 0;
        background: transparent;
        font: inherit;
        color: var(--ink);
        cursor: pointer;
        transition: opacity 420ms ease, visibility 0ms linear 420ms;
      }

      .open .opener {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .envelope-card {
        width: min(86vw, 330px);
        display: grid;
        gap: 22px;
        justify-items: center;
        transform: rotate(-2deg);
        animation: envelopeArrive 620ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      .envelope {
        position: relative;
        width: min(78vw, 300px);
        aspect-ratio: 1.48;
        border-radius: 8px;
        background: #fff8ef;
        box-shadow: 0 28px 70px rgba(74, 42, 61, 0.24);
        overflow: hidden;
      }

      .envelope::before,
      .envelope::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      .envelope::before {
        background:
          linear-gradient(33deg, transparent 49.5%, rgba(239, 95, 126, 0.38) 50%),
          linear-gradient(147deg, transparent 49.5%, rgba(255, 148, 114, 0.38) 50%);
      }

      .envelope::after {
        top: -54%;
        height: 96%;
        border-radius: 0 0 8px 8px;
        background: linear-gradient(160deg, #ffe0e8, #ffc3d1);
        transform: rotate(45deg);
        box-shadow: 0 10px 22px rgba(239, 95, 126, 0.13);
      }

      .seal {
        position: absolute;
        left: 50%;
        top: 51%;
        z-index: 2;
        width: 52px;
        height: 52px;
        background: linear-gradient(145deg, var(--rose), var(--coral));
        transform: translate(-50%, -50%) rotate(45deg);
        box-shadow: 0 12px 24px rgba(239, 95, 126, 0.28);
      }

      .seal::before,
      .seal::after {
        content: "";
        position: absolute;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: inherit;
      }

      .seal::before {
        left: -26px;
        top: 0;
      }

      .seal::after {
        left: 0;
        top: -26px;
      }

      .open-text {
        padding: 11px 17px;
        border: 1px solid rgba(47, 35, 52, 0.13);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.82);
        box-shadow: 0 14px 34px rgba(74, 42, 61, 0.14);
        color: var(--soft-ink);
        font-size: 0.82rem;
        font-weight: 900;
        text-transform: uppercase;
      }

      @keyframes slideIn {
        from {
          opacity: 0;
          transform: translateY(24px) rotate(0deg) scale(0.98);
        }
      }

      @keyframes heartBob {
        0%,
        100% {
          transform: translateY(0) rotate(45deg);
        }
        50% {
          transform: translateY(-12px) rotate(49deg);
        }
      }

      @keyframes envelopeArrive {
        from {
          opacity: 0;
          transform: translateY(18px) rotate(0deg) scale(0.96);
        }
      }

      @keyframes bubbleBob {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-10px);
        }
      }

      @keyframes pop {
        to {
          opacity: 0;
          transform: translate(var(--x), var(--y)) scale(0);
        }
      }

      @media (max-width: 520px) {
        body {
          place-items: start center;
        }

        .wrap {
          width: min(calc(100vw - 24px), 390px);
          min-height: 100svh;
          padding: max(14px, env(safe-area-inset-top)) 0 max(14px, env(safe-area-inset-bottom));
        }

        .letter {
          padding: 28px 20px 22px;
        }

        .kiss {
          left: 18px;
          top: max(22px, env(safe-area-inset-top));
          width: 42px;
          height: 42px;
          opacity: 0.78;
        }

        .kiss::before,
        .kiss::after {
          width: 42px;
          height: 42px;
        }

        .kiss::before {
          left: -21px;
          top: 0;
        }

        .kiss::after {
          left: 0;
          top: -21px;
        }

        .bubble {
          top: min(79svh, 590px);
          right: 12px;
          max-width: 126px;
          padding: 9px 11px;
          border-radius: 15px 15px 5px 15px;
          font-size: 0.72rem;
        }

        .envelope-card {
          gap: 18px;
        }

        .open-text {
          font-size: 0.76rem;
        }
      }
    </style>
  </head>
  <body>
    <button class="opener" id="opener" type="button" aria-label="Tap to open the message">
      <span class="envelope-card">
        <span class="envelope" aria-hidden="true">
          <span class="seal"></span>
        </span>
        <span class="open-text">tap to open</span>
      </span>
    </button>

    <div class="floating kiss" aria-hidden="true"></div>
    <div class="floating bubble" aria-hidden="true">currently accepting attention</div>

    <main class="wrap">
      <section class="letter" aria-label="A small note">
        <div class="tag">private delivery to Derrano</div>
        <h1>i miss <span>you</span></h1>
        <p class="copy">
          This is me trying to be chill about it, but my phone is boring when
          your name is not on it.
        </p>

        <div class="meter" aria-label="Miss you meter">
          <div class="meter-top">
            <span>miss-you meter</span>
            <span id="percent">72%</span>
          </div>
          <div class="bar">
            <div class="fill" id="fill"></div>
          </div>
        </div>

        <div class="actions">
          <button id="missButton" type="button">make it worse</button>
          <a
            class="button ghost"
            id="textButton"
            href="sms:?&body=I%20miss%20you%20too.%20When%20can%20I%20see%20you%3F"
          >
            text me back
          </a>
        </div>

        <div class="response" id="response" aria-live="polite">
          tap the button!
        </div>
      </section>
    </main>

    <script>
      const lines = [
        "Lmao i knew you'll click that.",
        "come on, I know you miss me too.",
        "This is getting sad.",
        "Really?"
      ];

      const fill = document.querySelector("#fill");
      const percent = document.querySelector("#percent");
      const response = document.querySelector("#response");
      const missButton = document.querySelector("#missButton");
      const opener = document.querySelector("#opener");
      let score = 72;
      let lineIndex = 0;

      function burst(x, y) {
        const colors = ["#ef5f7e", "#ff9472", "#8fc9ff", "#9ed7bd", "#ffd166"];

        for (let index = 0; index < 22; index += 1) {
          const spark = document.createElement("span");
          const angle = (Math.PI * 2 * index) / 22;
          const distance = 46 + Math.random() * 48;
          spark.className = "spark";
          spark.style.left = `${x}px`;
          spark.style.top = `${y}px`;
          spark.style.background = colors[index % colors.length];
          spark.style.setProperty("--x", `${Math.cos(angle) * distance}px`);
          spark.style.setProperty("--y", `${Math.sin(angle) * distance}px`);
          document.body.appendChild(spark);
          spark.addEventListener("animationend", () => spark.remove());
        }
      }

      missButton.addEventListener("click", (event) => {
        score = Math.min(score + 7, 100);
        fill.style.width = `${score}%`;
        percent.textContent = `${score}%`;
        response.textContent = lines[lineIndex];
        lineIndex = (lineIndex + 1) % lines.length;
        burst(event.clientX, event.clientY);

        if (score === 100) {
          missButton.textContent = "emergency: call me";
        }
      });

      opener.addEventListener("click", () => {
        document.body.classList.add("open");
      });
    </script>
  </body>
</html>
